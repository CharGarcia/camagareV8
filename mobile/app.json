{
  "expo": {
    "name": "CaMaGaRe",
    "slug": "camagare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.camagare.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.camagare.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CaMaGaRe usa tu ubicación solo al confirmar una entrega, para registrar dónde se hizo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CaMaGaRe usa tus fotos solo para la imagen del producto que estás creando o editando.",
          "cameraPermission": "CaMaGaRe usa la cámara solo para tomar la foto del producto que estás creando o editando."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CaMaGaRe usa la cámara para escanear el código QR y tomar la selfie al marcar tu asistencia."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90a956e5-114d-4880-861c-6b4f95105572"
      }
    },
    "owner": "cmg-business-administration"
  }
}
