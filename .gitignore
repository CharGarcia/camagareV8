# SEGURIDAD: todo .php suelto en public/ es una URL pública en producción
# (el docroot es /var/www/sistema/public). Los scripts de diagnóstico que se
# dejen ahí quedan expuestos a internet sin autenticación: no se versionan y
# se borran del servidor apenas se usan.
public/get_*.php
public/schema*.php
public/kill_*.php
public/update_db*.php
public/migracion.php
public/log_*.php
public/test-*.php
public/tmp_*.php
public/probar_*.php
public/ver_*.php
